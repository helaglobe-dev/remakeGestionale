# Hostname assegnato alla risorsa pubblica Pangolin, senza https://
PUBLIC_HOSTNAME=gestionale.example.com

# Valori generati quando si crea il Site in Pangolin Cloud.
PANGOLIN_ENDPOINT=https://app.pangolin.net
SITE_ID=incolla-qui-id-site
SITE_SECRET=incolla-qui-secret-site

# Cambiare prima del primo seed. Minimo consigliato: 16 caratteri casuali.
SEED_PASSWORD=cambia-questa-password-demo

TZ=Europe/Rome
BACKUP_RETENTION_DAYS=30
