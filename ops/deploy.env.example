# Hostname pubblico configurato come route del Tunnel, senza https://
PUBLIC_HOSTNAME=gestionale.example.com

# Token del tunnel remoto. Non committare mai il valore reale.
CLOUDFLARE_TUNNEL_TOKEN=incolla-qui-il-token-del-tunnel

# Cambiare prima del primo seed. Minimo consigliato: 16 caratteri casuali.
SEED_PASSWORD=cambia-questa-password-demo

TZ=Europe/Rome
BACKUP_RETENTION_DAYS=30
