{
  "name": "helaproject-remake",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "db:push": "drizzle-kit push",
    "db:seed": "node server/db/seed.ts",
    "db:reset": "echo \"Attenzione: sostituisce i dati con quelli demo. Usa db:reset:confirm\" && exit 1",
    "postinstall": "nuxt prepare",
    "test": "node --test --test-concurrency=1 tests/api/",
    "test:ui": "node tests/ui/smoke.mjs",
    "db:import": "node server/db/import/parse-dump.mjs \"$DUMP\" data/import && node server/db/import/import-production.ts data/import --user \"$IMPORT_USER\"",
    "test:prepare": "DATABASE_URL=file:./data/test.db drizzle-kit push --force && DATABASE_URL=file:./data/test.db node server/db/seed.ts --reset",
    "test:server": "nuxt build && DATABASE_URL=file:./data/test.db PORT=3002 node .output/server/index.mjs",
    "db:reset:confirm": "drizzle-kit push --force && node server/db/seed.ts --reset"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mdi/font": "^7.4.47",
    "apexcharts": "^8.7.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.3",
    "vuetify": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.14"
  }
}
